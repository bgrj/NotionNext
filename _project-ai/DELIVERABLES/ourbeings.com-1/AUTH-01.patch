+})
+
+test('slow loading gives retry feedback without pretending to be signed in', () => {
+  jest.useFakeTimers()
+  mockSession = { isLoaded: false, isSignedIn: undefined, user: null }
+  render(<BeingDesk />)
+  act(() => jest.advanceTimersByTime(12000))
