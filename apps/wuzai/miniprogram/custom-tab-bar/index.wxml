<view class="floating-nav">
  <button class="tab {{current === 'pages/index/index' ? 'selected' : ''}}" data-page="index/index" bindtap="tab"><text>Our Being</text><text class="slogan">{{t['与世界同在']}}</text></button>
  <button class="plus" bindtap="toggle" aria-label="Create">＋</button>
  <button class="tab {{current === 'pages/mine/mine' ? 'selected' : ''}}" data-page="mine/mine" bindtap="tab"><text>My Being</text><text class="slogan">{{t['与自我疏离']}}</text></button>
</view>
<view wx:if="{{open}}" class="mask" bindtap="close"><view class="sheet" catchtap="noop">
  <block wx:if="{{current === 'pages/mine/mine'}}"><button data-action="dao" bindtap="choose">{{t['道']}}</button><button data-action="shu" bindtap="choose">{{t['术']}}</button><button data-action="existence" bindtap="choose">{{t['我的存在']}}</button></block>
  <block wx:else><button data-action="reading" bindtap="choose">{{t['发起共读']}}</button><button data-action="conversation" bindtap="choose">{{t['发起共话']}}</button><button data-action="cities" bindtap="choose">{{t['选择城市']}}</button></block>
  <button class="cancel" bindtap="close">{{t['取消']}}</button>
</view></view>
