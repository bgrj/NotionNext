.floating-nav { position:fixed; bottom:calc(24rpx + env(safe-area-inset-bottom)); left:24rpx; right:24rpx; min-height:152rpx; padding:16rpx; display:flex; align-items:center; justify-content:space-around; border-radius:80rpx; background:var(--paper,#fffdf9); border:1rpx solid var(--line,#e3dbce); box-shadow:0 4rpx 32rpx #0000000d; z-index:20; }
button { margin:0; padding:0; background:transparent; border:0; border-radius:0; font-family:"Times New Roman",serif; }
button::after { border:0; }
.tab { flex:1; min-width:0; min-height:112rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; line-height:1.5; color:#766a5f; font-size:32rpx; }
.selected { color:#342c24; }
.slogan { font-size:26rpx; font-style:italic; margin-top:8rpx; white-space:normal; }
.plus { width:96rpx; height:96rpx; min-height:96rpx; border-radius:50%; background:#000; color:#fff; font-size:54rpx; flex:none; }
.mask { position:fixed; inset:0; background:#0007; z-index:100; display:flex; align-items:flex-end; }
.sheet { width:100%; padding:16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius:32rpx 32rpx 0 0; background:#fffdf9; }
.sheet button { width:100%; min-height:100rpx; padding:24rpx; border-bottom:1rpx solid #e3dbce; line-height:1.6; display:flex; align-items:center; justify-content:center; font-size:32rpx; color:#342c24; }
.sheet .cancel { color:#a03b2f; margin-top:16rpx; border:0; }
@media(prefers-color-scheme:dark) { .floating-nav,.sheet { background:#211c17; border-color:#4a3f34; } .tab {color:#c1b5a3;} .selected,.sheet button {color:#f1e9dc;} .sheet button {border-color:#4a3f34;} .sheet .cancel {color:#ffaea0;} }
