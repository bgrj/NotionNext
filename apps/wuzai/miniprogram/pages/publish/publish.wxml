<view class="page"><view class="language-switch"><button class="{{locale === 'zh' ? 'active' : ''}}" data-language="zh" bindtap="changeLanguage">中文</button><button class="{{locale === 'en' ? 'active' : ''}}" data-language="en" bindtap="changeLanguage">English</button></view><text class="eyebrow">{{t['留一段时间，邀请彼此走近']}}</text><text class="title">{{t['发起一次相遇']}}</text><text class="muted intro">{{t['先保存草稿，再确认发布。时间均为北京时间。']}}</text>
<view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="empty">{{t['正在读取安排…']}}</view>
<block wx:if="{{!cannotEdit && !loading}}">
<text class="hint">{{t['本地时间']}} · {{timezone}}</text><label class="label">{{t['交流语言']}}</label><picker range="{{['中文','English',t['中英双语']]}}" bindchange="chooseLanguage"><view class="picker">{{language}}</view></picker><label class="label">{{t['城市']}}</label><input value="{{city}}" data-field="city" bindinput="input" maxlength="80" /><label class="label">{{t['交流渠道']}}</label><picker range="{{['WeChat','QQ','Telegram','WhatsApp','LINE',t['其他']]}}" bindchange="chooseChannel"><view class="picker">{{channel}}</view></picker><label class="label">{{t['活动名称']}}</label><input value="{{title}}" data-field="title" bindinput="input" maxlength="80" placeholder="{{t['一起读一本书、聊一个问题']}}" />
<label class="label">{{t['相遇方式']}}</label><picker range="{{[t['共读'],t['交流']]}}" bindchange="chooseKind"><view class="picker">{{kind === 'reading' ? t['共读'] : t['交流']}}</view></picker>
<label class="label">{{t['书名、材料或主题']}}</label><input value="{{book}}" data-field="book" bindinput="input" maxlength="120" />
<label class="label">{{t['活动介绍']}}</label><textarea value="{{description}}" data-field="description" bindinput="input" maxlength="4000" placeholder="{{t['为什么相遇？会读什么，需要准备什么？']}}" />
<label class="label">{{t['开始日期与时间']}}</label><picker mode="date" value="{{date}}" data-field="date" bindchange="input"><view class="picker">{{date || t['选择开始日期']}}</view></picker><picker mode="time" value="{{time}}" data-field="time" bindchange="input"><view class="picker">{{time}}</view></picker>
<label class="label">{{t['结束日期与时间']}}</label><picker mode="date" value="{{endDate}}" data-field="endDate" bindchange="input"><view class="picker">{{endDate || t['同开始日期']}}</view></picker><picker mode="time" value="{{endTime}}" data-field="endTime" bindchange="input"><view class="picker">{{endTime}}</view></picker>
<label class="label">{{t['预约截止日期与时间']}}</label><picker mode="date" value="{{deadlineDate}}" data-field="deadlineDate" bindchange="input"><view class="picker">{{deadlineDate || t['活动开始前均可预约']}}</view></picker><picker wx:if="{{deadlineDate}}" mode="time" value="{{deadlineTime}}" data-field="deadlineTime" bindchange="input"><view class="picker">{{deadlineTime}}</view></picker>
<label class="label">{{t['名额（不含发起人，1–500）']}}</label><input type="number" value="{{capacity}}" data-field="capacity" bindinput="input" />
<label class="label">{{t['活动形式']}}</label><picker range="{{[t['线上'],t['线下']]}}" bindchange="chooseFormat"><view class="picker">{{format === 'online' ? t['线上'] : t['线下']}}</view></picker>
<label class="label">{{t['城市、场地或线上方式（公开）']}}</label><input value="{{location}}" data-field="location" bindinput="input" maxlength="160" />
<label class="label">{{t['入群与参与说明']}}</label><textarea value="{{joinInstructions}}" data-field="joinInstructions" bindinput="input" maxlength="1000" placeholder="{{t['选择渠道，填写群链接、入群方式或联系说明。']}}" /><text class="hint">{{t['仅预约成功后可见。请勿在公开介绍中填写私人联系方式。']}}</text>
<button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="save">{{id ? t['保存安排'] : t['保存草稿']}}</button>
</block></view>
