<view class="page home-page"><view class="philosophy-head"><image class="scene" src="/images/meeting-sky.jpg" mode="aspectFill" aria-hidden="true" /><button class="head-settings" bindtap="settings">{{t['设置']}}</button><text class="eyebrow">MY BEING</text><text class="title">{{nickname || t['与自我疏离']}}</text><text class="slogan">{{t['留一处，安放自己的思想。']}}</text></view>
<view class="home-content"><view wx:if="{{!loggedIn}}" class="sign-in-row"><view><text class="heading">{{t['我的空间']}}</text><text class="hint">{{t['登录后留住活动与创作。']}}</text></view><button class="primary" bindtap="login" loading="{{loggingIn}}" disabled="{{loggingIn}}">{{t['微信登录']}}</button></view>
<view class="quick-actions room-actions"><button data-room="dao" bindtap="compose"><text class="action-mark">{{t['道']}}</text><text>{{t['思考与理解']}}</text></button><button data-room="shu" bindtap="compose"><text class="action-mark">{{t['术']}}</text><text>{{t['方法与实践']}}</text></button><button data-room="existence" bindtap="compose"><text class="action-mark existence-mark">{{t['我的存在']}}</text><text>{{t['生活与自述']}}</text></button></view>
<view class="tabs section-tabs"><button class="{{mineSection === 'activities' ? 'active' : ''}}" data-section="activities" bindtap="sectionTap">{{t['我的活动']}}</button><button class="{{mineSection === 'writings' ? 'active' : ''}}" data-section="writings" bindtap="sectionTap">{{t['我的创作']}}</button></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">{{t['重新读取']}}</button></view>
<block wx:if="{{mineSection === 'activities'}}"><view class="segmented"><button class="{{relation === 'all' ? 'active' : ''}}" data-relation="all" bindtap="relationTap">{{t['全部']}}</button><button class="{{relation === 'host' ? 'active' : ''}}" data-relation="host" bindtap="relationTap">{{t['我发起的']}}</button><button class="{{relation === 'reserved' ? 'active' : ''}}" data-relation="reserved" bindtap="relationTap">{{t['我的预约']}}</button><button class="{{relation === 'draft' ? 'active' : ''}}" data-relation="draft" bindtap="relationTap">{{t['草稿']}}</button></view><view wx:for="{{visible}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><text class="badge">{{t[item.statusLabel] || item.statusLabel}}</text><text class="card-title">{{item.title}}</text><text class="facts">{{item.timeLabel}} · {{item.location}}</text></view><view wx:if="{{loading}}" class="empty">{{t['正在读取…']}}</view><view wx:elif="{{!visible.length && !error}}" class="empty"><text class="heading">{{t['下一次相遇，从这里开始']}}</text><text class="muted">{{t['发起与预约的活动，都会留在这里。']}}</text><button bindtap="create">{{t['发起活动']}}</button></view><button wx:if="{{nextOffset !== null}}" bindtap="more" disabled="{{loading}}">{{t['继续查看']}}</button></block>
<block wx:else><view wx:for="{{writings}}" wx:key="id" class="card"><text class="badge">{{item.room === 'dao' ? t['道'] : item.room === 'shu' ? t['术'] : t['我的存在']}} · {{item.public ? t['公开'] : t['私密']}}</text><text class="card-title">{{item.title}}</text><text class="body">{{item.body}}</text><text class="hint">{{item.timeLabel}}</text></view><view wx:if="{{writingsLoading}}" class="empty">{{t['正在读取…']}}</view><view wx:elif="{{!writings.length && !error}}" class="empty"><text class="heading">{{t['从一句自己的话开始']}}</text><text class="muted">{{t['点击中间加号，写下道、术或我的存在。']}}</text></view></block>
</view></view>
