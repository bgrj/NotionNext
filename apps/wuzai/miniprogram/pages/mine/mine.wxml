<view class="page"><view class="language-switch"><button class="{{locale === 'zh' ? 'active' : ''}}" data-language="zh" bindtap="changeLanguage">中文</button><button class="{{locale === 'en' ? 'active' : ''}}" data-language="en" bindtap="changeLanguage">English</button></view><view class="philosophy-head"><image class="scene" src="/images/meeting-sky.jpg" mode="aspectFill" aria-hidden="true" /><text class="eyebrow">MY BEING</text><text class="title">{{t['我的空间']}}</text><text class="slogan">{{t['与自我疏离']}}</text></view>
  <view class="account"><text class="heading">{{loggedIn ? t['已使用微信登录'] : t['用微信留住每次相遇']}}</text><text class="muted">{{loggedIn ? t['发起与预约的活动会归属于当前微信账号。'] : t['登录后可查看你发起和预约的活动。']}}</text><button wx:if="{{!loggedIn}}" class="primary" bindtap="login" loading="{{loggingIn}}" disabled="{{loggingIn}}">{{loggingIn ? t['正在微信登录…'] : t['微信登录']}}</button><text class="hint">{{t['无需另设密码，也不需要手机号。微信与网站账号目前独立。']}}</text></view>
  <view wx:if="{{loggedIn}}" class="nickname"><label class="label" for="nickname">{{t['希望大家怎么称呼你']}}</label><input id="nickname" type="nickname" value="{{nickname}}" maxlength="30" bindinput="nicknameInput" placeholder="{{t['共读时使用的称呼，可选']}}" /><button bindtap="saveNickname">{{t['保存称呼']}}</button><text class="hint">{{t['不需要填写手机号或私人联系方式。']}}</text></view>
  <button class="primary" bindtap="create">{{t['发起活动']}}</button>
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">{{t['重新读取']}}</button></view>
  <view wx:for="{{visible}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><text class="badge">{{item.isHost ? t['我发起的'] : item.reservation === 'confirmed' ? t['已预约'] : t['已取消预约']}} · {{t[item.statusLabel] || item.statusLabel}}</text><text class="card-title">{{item.title}}</text><text class="facts">{{item.timeLabel}} · {{timezone}}</text><text class="muted">{{item.location}}</text></view>
  <view wx:if="{{loading}}" class="empty">{{t['正在读取…']}}</view><view wx:elif="{{loggedIn && !visible.length && !error}}" class="empty"><text class="heading">{{t['下一次相遇，从这里开始']}}</text><text class="muted">{{t['发起与预约的活动，都会留在这里。']}}</text></view>
  <button wx:if="{{nextOffset !== null}}" bindtap="more" disabled="{{loading}}">{{t['继续查看']}}</button><button bindtap="privacy">{{t['隐私与使用说明']}}</button>
</view>
