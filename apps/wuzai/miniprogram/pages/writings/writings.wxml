<view class="page"><text class="title">{{t['公开创作']}}</text><view class="segmented"><button data-room="all" bindtap="choose" class="{{room === 'all' ? 'active' : ''}}">{{t['全部']}}</button><button data-room="dao" bindtap="choose" class="{{room === 'dao' ? 'active' : ''}}">{{t['道']}}</button><button data-room="shu" bindtap="choose" class="{{room === 'shu' ? 'active' : ''}}">{{t['术']}}</button><button data-room="existence" bindtap="choose" class="{{room === 'existence' ? 'active' : ''}}">{{t['我的存在']}}</button></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">{{t['重新读取']}}</button></view><view wx:for="{{visible}}" wx:key="id" class="writing-card"><text class="badge">{{item.room === 'dao' ? t['道'] : item.room === 'shu' ? t['术'] : t['我的存在']}}</text><text class="card-title">{{item.title}}</text><text class="body">{{item.body}}</text><text class="hint">{{item.author}} · {{item.timeLabel}}</text></view><text wx:if="{{loading}}" class="empty">{{t['正在读取…']}}</text><text wx:elif="{{!visible.length && !error}}" class="empty">{{t['还没有公开创作']}}</text></view>
