.intro { padding:32rpx 0 16rpx; }
.intro .heading { font-size:44rpx; margin-top:0; }
.intro .primary { display:inline-flex; }
.filters { display:flex; flex-wrap:wrap; gap:16rpx; margin:32rpx 0; }
.filters .filter { flex:1; min-width:0; margin:0; }
.filters button { font-size:28rpx; }
.filters .picker { height:100%; display:flex; align-items:center; justify-content:center; padding:16rpx; }
.list-toolbar { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16rpx; border-block:1rpx solid var(--line); }
.list-toolbar .tabs { border:0; margin:0; }
.format-picker { min-height:88rpx; padding:16rpx 0; font-size:28rpx; color:var(--muted); display:flex; align-items:center; }
