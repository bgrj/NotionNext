<view class="page"><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新读取</button></view><view wx:if="{{loading}}" class="empty">正在读取这次相遇…</view>
<block wx:if="{{event}}"><text class="badge">{{event.statusLabel}}</text><text class="title">{{event.title}}</text><text class="muted">由 {{event.hostName}} 发起 · {{event.book}}</text>
<view class="section"><text class="facts">{{event.timeLabel}} 至 {{event.endLabel}} · 北京时间</text><text class="facts">{{event.location}}</text><text class="facts">{{event.booked}} / {{event.capacity}} 人已预约 · 余 {{event.remaining}} 位</text><text class="facts">预约截止 {{event.deadlineLabel}}</text></view>
<view class="section"><text class="heading">关于这次相遇</text><text class="body">{{event.description}}</text></view>
<view class="reserve"><text class="heading">{{event.isHost ? '你发起的相遇' : event.reservation === 'confirmed' ? '已为你留好一个位置' : '为对话留出一点时间'}}</text><button wx:if="{{event.canReserve}}" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="reserve">预约这次相遇</button><button wx:if="{{event.reservation === 'confirmed'}}" disabled="{{busy}}" bindtap="cancelReservation">取消预约</button><text wx:if="{{!event.canReserve &amp;&amp; !member}}" class="muted">{{event.statusLabel}}</text></view>
<view wx:if="{{member &amp;&amp; event.joinInstructions}}" class="private"><text class="heading">{{event.discussion === 'wechat' ? '发起人的活动微信群' : '预约后的参与说明'}}</text><text class="body">{{event.joinInstructions}}</text><button bindtap="copyInstructions">复制参与说明</button><text class="hint">仅向发起人和已预约者展示。</text></view>
<view wx:if="{{member &amp;&amp; event.discussion === 'site'}}" class="private"><text>本场活动使用网站交流群，预约后请在网站中参与。</text><text class="hint">微信账号与网站账号目前独立，网站仍需使用已预约的账号进入。</text><button bindtap="openSite">复制网站活动链接</button></view>
<view class="section"><text class="heading">活动通知</text><text wx:if="{{!event.announcements.length}}" class="muted">还没有新的通知，参与前请再来看看。</text><view wx:for="{{event.announcements}}" wx:key="id" class="notice"><text class="hint">{{item.timeLabel}}</text><text class="body">{{item.body}}</text></view></view>
<view wx:if="{{event.isHost}}" class="section"><text class="heading">发起人的安排</text><button wx:if="{{event.state === 'draft'}}" class="primary" disabled="{{busy}}" bindtap="publish">公开发布活动</button><button wx:if="{{event.status !== 'ongoing' &amp;&amp; event.status !== 'ended' &amp;&amp; event.status !== 'cancelled'}}" bindtap="edit">编辑安排</button><block wx:if="{{event.state === 'published'}}"><label class="label">发布活动通知</label><textarea value="{{notice}}" bindinput="noticeInput" maxlength="1000" placeholder="准备材料、集合与时间提醒" /><button disabled="{{busy || !notice}}" bindtap="announce">发布通知</button></block><button wx:if="{{event.status !== 'ended' &amp;&amp; event.status !== 'cancelled'}}" disabled="{{busy}}" bindtap="cancelEvent">取消活动</button></view>
<button wx:if="{{event.state === 'published'}}" open-type="share">分享这次相遇</button>
</block></view>
