<view class="page"><view class="language-switch"><button class="{{locale === 'zh' ? 'active' : ''}}" data-language="zh" bindtap="changeLanguage">中文</button><button class="{{locale === 'en' ? 'active' : ''}}" data-language="en" bindtap="changeLanguage">English</button></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">{{t['重新读取']}}</button></view><view wx:if="{{loading}}" class="empty">{{t['正在读取这次相遇…']}}</view>
<block wx:if="{{event}}"><text class="badge">{{t[event.statusLabel] || event.statusLabel}}</text><text class="title">{{event.title}}</text><text class="muted">{{t['由']}} {{event.hostName}} {{t['发起 ·']}} {{event.book}}</text>
<view class="section"><text class="facts">{{event.timeLabel}} {{t['至']}} {{event.endLabel}} · {{timezone}}</text><text class="facts">{{event.location}}</text><text class="facts">{{event.booked}} / {{event.capacity}} {{t['人已预约 · 余']}} {{event.remaining}} {{t['位']}}</text><text class="facts">{{t['预约截止']}} {{event.deadlineLabel}}</text></view>
<view class="section"><text class="heading">{{t['关于这次相遇']}}</text><text class="body">{{event.description}}</text></view>
<view class="reserve"><text class="heading">{{event.isHost ? t['你发起的相遇'] : event.reservation === 'confirmed' ? t['已为你留好一个位置'] : t['为对话留出一点时间']}}</text><button wx:if="{{event.canReserve}}" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="reserve">{{t['预约这次相遇']}}</button><button wx:if="{{event.reservation === 'confirmed'}}" disabled="{{busy}}" bindtap="cancelReservation">{{t['取消预约']}}</button><text wx:if="{{!event.canReserve && !member}}" class="muted">{{t[event.statusLabel] || event.statusLabel}}</text></view>
<view wx:if="{{member && event.joinInstructions}}" class="private"><text class="heading">{{event.discussion === 'wechat' ? t['发起人的交流群'] : t['预约后的参与说明']}}</text><text class="body">{{event.joinInstructions}}</text><button bindtap="copyInstructions">{{t['复制参与说明']}}</button><text class="hint">{{t['仅向发起人和已预约者展示。']}}</text></view>
<view wx:if="{{member && event.discussion === 'site'}}" class="private"><text>{{t['本场活动使用网站交流群，预约后请在网站中参与。']}}</text><text class="hint">{{t['微信账号与网站账号目前独立，网站仍需使用已预约的账号进入。']}}</text><button bindtap="openSite">{{t['复制网站活动链接']}}</button></view>
<view class="section"><text class="heading">{{t['活动通知']}}</text><text wx:if="{{!event.announcements.length}}" class="muted">{{t['还没有新的通知，参与前请再来看看。']}}</text><view wx:for="{{event.announcements}}" wx:key="id" class="notice"><text class="hint">{{item.timeLabel}}</text><text class="body">{{item.body}}</text></view></view>
<view wx:if="{{event.isHost}}" class="section"><text class="heading">{{t['发起人的安排']}}</text><button wx:if="{{event.state === 'draft'}}" class="primary" disabled="{{busy}}" bindtap="publish">{{t['公开发布活动']}}</button><button wx:if="{{event.status !== 'ongoing' && event.status !== 'ended' && event.status !== 'cancelled'}}" bindtap="edit">{{t['编辑安排']}}</button><block wx:if="{{event.state === 'published'}}"><label class="label">{{t['发布活动通知']}}</label><textarea value="{{notice}}" bindinput="noticeInput" maxlength="1000" placeholder="{{t['准备材料、集合与时间提醒']}}" /><button disabled="{{busy || !notice}}" bindtap="announce">{{t['发布通知']}}</button></block><button wx:if="{{event.status !== 'ended' && event.status !== 'cancelled'}}" disabled="{{busy}}" bindtap="cancelEvent">{{t['取消活动']}}</button></view>
<button wx:if="{{event.state === 'published'}}" open-type="share">{{t['分享这次相遇']}}</button>
</block></view>
