<view class="page"><text class="title">{{t['选择城市']}}</text><input value="{{query}}" bindinput="search" maxlength="80" placeholder="{{t['搜索世界各地城市']}}" /><button data-city="" bindtap="choose">{{t['所有城市']}}</button><button wx:for="{{cities}}" wx:key="id" data-city="{{item.id}}" bindtap="choose">{{item.label}}</button><button wx:if="{{query}}" class="primary" bindtap="custom">{{t['使用这座城市']}} · {{query}}</button></view>
